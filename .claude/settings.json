{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/auto-commit.ps1\"",
            "timeout": 60,
            "statusMessage": "Auto-commit ./claude..."
          }
        ]
      }
    ]
  }
}
